# Local-first Paper Recommendation Agent configuration

# LLM provider. Any OpenAI-compatible endpoint can be used.
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL_NAME=gpt-4o-mini

# Zotero Web API configuration.
ZOTERO_USER_ID=
ZOTERO_API_KEY=
ZOTERO_LIBRARY_TYPE=user
ZOTERO_ANALYSIS_SCOPE=all
ZOTERO_SELECTED_COLLECTIONS=

# User-facing recommendation settings.
USER_INTEREST_KEYWORDS=large language models, retrieval augmented generation, AI agents
ARXIV_CATEGORIES=cs.AI,cs.CL,cs.LG
ARXIV_LOOKBACK_DAYS=3
ARXIV_MAX_RESULTS=50
ARXIV_REQUEST_DELAY_SECONDS=3
ARXIV_NUM_RETRIES=1
